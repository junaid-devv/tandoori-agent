{
  "name": "tandoori-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:category-routing": "node scripts/check-category-routing.mjs",
    "check:interactive-guards": "node scripts/check-interactive-guards.mjs",
    "check:parser-regressions": "node scripts/check-parser-regressions.mjs",
    "check:intent-phrase-table": "node scripts/check-intent-phrase-table.mjs",
    "check:flow-handlers": "node --no-warnings --experimental-strip-types scripts/check-order-flow-handlers.mjs",
    "check:upsell-qty-regression": "node --no-warnings --experimental-strip-types scripts/check-upsell-quantity-regression.mjs",
    "check:webhook-helpers": "node --no-warnings --experimental-strip-types scripts/check-webhook-helpers.mjs",
    "check:urdu-voice-regressions": "node --no-warnings --experimental-strip-types scripts/check-urdu-voice-regressions.mjs",
    "check:direct-order-regressions": "node --no-warnings --experimental-strip-types scripts/check-direct-order-regressions.mjs",
    "check:operational-regressions": "node scripts/check-operational-regressions.mjs",
    "check:whatsapp-status-regressions": "node scripts/check-whatsapp-status-regressions.mjs",
    "check:advanced-restaurant-features": "node scripts/check-advanced-restaurant-features.mjs",
    "check:security-regressions": "node scripts/check-security-regressions.mjs",
    "check:production-readiness": "node scripts/check-production-readiness.mjs",
    "prepare:production-secrets": "node scripts/prepare-production-secrets.mjs",
    "check:all-guards": "npm run check:category-routing && npm run check:interactive-guards && npm run check:parser-regressions && npm run check:intent-phrase-table && npm run check:flow-handlers && npm run check:upsell-qty-regression && npm run check:webhook-helpers && npm run check:urdu-voice-regressions && npm run check:direct-order-regressions && npm run check:operational-regressions && npm run check:whatsapp-status-regressions && npm run check:advanced-restaurant-features && npm run check:security-regressions",
    "demo:seed": "node --no-warnings --experimental-strip-types demo/seed/seed-demo-data.ts",
    "demo:record": "node --no-warnings --experimental-strip-types demo/playwright/record-product-demo.ts",
    "demo:record:headed": "node --no-warnings --experimental-strip-types demo/playwright/record-product-demo-headed.ts",
    "demo:debug": "npx playwright test --config=demo/playwright/playwright.demo.config.ts --debug",
    "db:clear-chat": "node --no-warnings --experimental-strip-types scripts/clear_chat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "openai": "^6.33.0",
    "playwright": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
