# Copy to .env beside docker-compose.yml. Use different random secrets below.
SERVER_URL=https://whatsapp.your-domain.example
# Required only with docker-compose.https.yml; Azure must allow TCP 80 and 443.
EVOLUTION_HOST=whatsapp.your-domain.example
AUTHENTICATION_API_KEY=replace-with-a-random-64-character-hex-secret
POSTGRES_PASSWORD=replace-with-a-different-random-64-character-hex-secret
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
