# Supabase
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# AI providers
# OpenRouter is used for order NLU by default. Google AI Studio is optional fallback/alternate for support and menu image parsing.
OPENROUTER_API_KEY=sk-or-v1-...
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
GROQ_AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ORDER_AGENT_NLU_MODEL=openrouter/auto
ORDER_AGENT_NLU_MAX_TOKENS=256
AI_REQUEST_TIMEOUT_MS=15000
MENU_AI_REQUEST_TIMEOUT_MS=25000

# Optional menu embeddings
OPENAI_API_KEY=
MENU_EMBEDDING_API_KEY=
MENU_EMBEDDING_BASE_URL=https://api.openai.com/v1
MENU_EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp Provider Selection: "meta" (official Cloud API) or "wa_akg" (self-hosted Baileys gateway)
WHATSAPP_PROVIDER=meta

# WhatsApp / Meta Cloud API (Used when WHATSAPP_PROVIDER=meta)
# Found in Meta for Developers > App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=replace_with_long_random_secret
WHATSAPP_REQUEST_TIMEOUT_MS=15000

# WA-AKG Gateway Settings (Used when WHATSAPP_PROVIDER=wa_akg)
WA_AKG_BASE_URL=http://localhost:3001
WA_AKG_API_KEY=wag_your_api_key_here
WA_AKG_SESSION_ID=default
WA_AKG_WEBHOOK_SECRET=

# Rate limits
RATE_LIMIT_HASH_SECRET=replace_with_long_random_secret
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
WHATSAPP_WEBHOOK_RATE_LIMIT_EVENTS=600
WHATSAPP_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_WEBHOOK_RATE_LIMIT_BLOCK_SECONDS=60
WHATSAPP_FLOW_RATE_LIMIT_EVENTS=300
WHATSAPP_FLOW_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_FLOW_RATE_LIMIT_BLOCK_SECONDS=60

# Webhook privacy defaults
# Keep both false in production unless a temporary incident investigation requires more raw logs.
WEBHOOK_STORE_RAW_BODY=false
WEBHOOK_RETAIN_PROCESSED_PAYLOAD=false

# Branding and restaurant defaults
NEXT_PUBLIC_APP_NAME=ORDERiQ
NEXT_PUBLIC_APP_CITY=City
NEXT_PUBLIC_APP_PHONE_DELIVERY=Update delivery phone
NEXT_PUBLIC_APP_PHONE_DINE_IN=Update dine-in phone
NEXT_PUBLIC_APP_CURRENCY=Rs.
NEXT_PUBLIC_BRAND_COLOR=#ea580c
NEXT_PUBLIC_BRAND_HOVER_COLOR=#c2410c
NEXT_PUBLIC_LOGO_URL=
RESTAURANT_BRANCH_MODE=single
RESTAURANT_TIMEZONE=Asia/Karachi

# Optional health endpoint protection for /api/health
HEALTHCHECK_SECRET=replace_with_long_random_secret

# Destructive admin maintenance
# Keep false unless production staff explicitly need the dashboard reset endpoint.
ADMIN_RESET_ENABLED=false
