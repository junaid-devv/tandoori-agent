# =====================================================================
# ORDERiQ — Environment Variables Template
# Single deployment, multi-tenant SaaS
# =====================================================================

# Supabase (shared database for all restaurants)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Evolution API v2 (shared server; each restaurant gets its own instance)
# Leave the URL/key empty until your Railway/VPS server is deployed.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
# Generate once using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable: changing this requires Sync Webhook Link for every tenant instance.
EVOLUTION_WEBHOOK_SECRET=
APP_URL=https://your-dashboard.example.com

# Meta WhatsApp Tech Provider
# Each client's token is obtained through Embedded Signup and stored server-side.
META_APP_SECRET=your-meta-app-secret
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Meta Embedded Signup (for onboarding client WhatsApp accounts)
# Found in Meta for Developers > App Settings (App ID) and WhatsApp > Quickstart / Embedded Signup (Configuration ID)
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=your-whatsapp-configuration-id

# AI Models
GROQ_API_KEY=your-groq-api-key
GROQ_AUDIO_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
DEEPSEEK_API_KEY=your-deepseek-api-key
ORDER_AGENT_NLU_BASE_URL=https://api.groq.com/openai/v1
ORDER_AGENT_NLU_MODEL=qwen/qwen3.8-27b
# Match the endpoint/model to the chosen credential. Groq uses its own endpoint.
ORDER_AGENT_NLU_MAX_TOKENS=1600
ORDER_AGENT_NLU_PRIMARY_MAX_TOKENS=900
ORDER_AGENT_NLU_TIMEOUT_MS=6000
ORDER_AGENT_NLU_TOTAL_TIMEOUT_MS=10000
ORDER_AGENT_ANSWER_TIMEOUT_MS=6000
AI_REQUEST_TIMEOUT_MS=15000
GOOGLE_AI_API_KEY=your-google-ai-key
OPENROUTER_API_KEY=your-openrouter-key

# Menu Embeddings
MENU_EMBEDDING_API_KEY=your-hf-api-key
MENU_EMBEDDING_BASE_URL=https://router.huggingface.co/deepinfra/v1/openai
MENU_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
MENU_EMBEDDING_DIMENSIONS=1536
HUGGINGFACE_API_KEY=your-hf-api-key

# Platform Identity & Security
NEXT_PUBLIC_APP_NAME="ORDERiQ"
RATE_LIMIT_HASH_SECRET=generate-a-random-secret
WORKER_API_KEY=generate-a-random-api-key
MOCK_WHATSAPP=false
ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
RESTAURANT_TIMEZONE=Asia/Karachi
